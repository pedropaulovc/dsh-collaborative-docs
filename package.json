{
  "name": "@pedropaulovc/dsh-collaborative-docs",
  "version": "0.2.0",
  "private": false,
  "description": "Local collaborative documents and comment threads for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pedropaulovc/dsh-collaborative-docs.git"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js"
  },
  "files": ["dist", "cordis.patch.yml", "LICENSE", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": [] }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "dev": "tsx src/dev.ts"
  },
  "dependencies": {
    "@blocknote/core": "0.57.0",
    "@blocknote/mantine": "0.57.0",
    "@blocknote/react": "0.57.0",
    "@blocknote/server-util": "0.57.0",
    "lib0": "^0.2.114",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.6",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.27.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true
  }
}
